<?xml version="1.0" encoding="utf-8"?>
<!-- A template: default.nix puts in the application ID (@APPLICATION_ID@,
     at.quickme.prism for the real app), the label (@LABEL@) and
     whether cleartext HTTP is allowed (@CLEARTEXT@: debug builds only, for a
     test server behind `adb reverse`). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="at.quickme.prism">

    <!-- The inbox's swipe: the notification shade's threshold click (Inbox.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The assistant's voice input (Voice.kt); granted by Prism itself as the Device Owner. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Granted once at enrollment (enroll.py, `pm grant`): battery stats for
         the metrics (Metrics.kt), and switching the assistant (Dpc.kt). -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Also: turning Wireless debugging back on for the shell server (shell/Signal.kt). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Self-update (Updater.kt): silent as the Device Owner, and on its own
         updates once Prism installed itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The Mac's request for the hotspot over Bluetooth LE (Hotspot.kt). Not
         neverForLocation: Android then filters out some advertisements, so
         the scan needs location, in the background too (results arrive while
         Prism isn't on screen). Granted by Prism itself as the Device Owner,
         in this order (Dpc.kt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The assistant's tools (src/at/quickme/prism/assistant/PhoneTools.kt):
         calls placed and texts sent without asking, texts, contacts and the
         calendar read to answer, alarms and timers in the clock app, Do Not
         Disturb. The runtime ones Prism grants itself as the Device Owner. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Also on Android TV, which has neither a touchscreen nor
         a phone's hardware; the TV opens Prism from its home screen
         (LEANBACK_LAUNCHER below). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- An agent's chat opens in T3 Code's app when it is installed (T3Activity.intent). -->
    <queries>
        <package android:name="com.t3tools.t3code" />
        <package android:name="at.quickme.t3chat" />
        <!-- Google's speech recognizer for the assistant's voice input (Voice.kt). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The apps the assistant opens by name, and what opens a link,
             directions or the clock (assistant/PhoneTools.kt). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:label="@LABEL@"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Prism"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="@CLEARTEXT@"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true">

        <!-- Managed configuration, if an MDM sets it (Settings.kt). -->
        <meta-data android:name="android.content.APP_RESTRICTIONS" android:resource="@xml/app_restrictions" />

        <!-- The keyboard is an inset the app handles: no pan, no resize. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ApproveActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- The voice interaction session launches this in Android's assistant
             layer, where excludeFromRecents applies even to the front task. -->
        <activity
            android:name=".AssistActivity"
            android:exported="false"
            android:label="@LABEL@"
            android:theme="@style/Theme.Prism.Assist"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <service
            android:name=".PrismAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/assistant_service" />
        </service>
        <service
            android:name=".PrismAssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".PrismRecognitionService" android:exported="false" />

        <activity android:name=".NetbirdActivity" android:exported="false" />
        <activity android:name=".PlacementActivity" android:exported="false" />
        <activity
            android:name=".T3Activity"
            android:exported="false"
            android:label="T3"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <service
            android:name=".PushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to a self-hosted push server (ntfy) for Prism's alerts and agent questions" />
        </service>

        <service
            android:name=".MetricsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- NetBird inside the app (netbird/Netbird.kt). -->
        <service
            android:name=".netbird.NetbirdVpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN: keeps this phone in the owner's NetBird network" />
        </service>

        <!-- The Device Owner (Dpc.kt): `dpm set-device-owner at.quickme.prism/.DeviceAdmin`. -->
        <receiver
            android:name=".DeviceAdmin"
            android:exported="true"
            android:label="Prism"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Settings over USB adb at enrollment (ProvisionProvider.kt); it
             admits adb's shell user only. -->
        <provider
            android:name=".ProvisionProvider"
            android:authorities="@APPLICATION_ID@.provision"
            android:exported="true"
            android:multiprocess="false" />

        <!-- Self-update (Updater.kt). -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".Updater$Done" android:exported="false" />

        <!-- Shell access (shell/, android/shizuku/README.md): the shell server hands
             its binder here, and so do its user services; only the shell user
             can reach it. -->
        <!-- The camera writes the photo the assistant overlay attaches here
             (AssistActivity.kt, CameraShots). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@APPLICATION_ID@.attach"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_paths" />
        </provider>

        <provider
            android:name=".shell.ShellProvider"
            android:authorities="@APPLICATION_ID@.shell"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity android:name=".shell.ShellActivity" android:exported="false" android:label="Shell access"
            android:launchMode="singleTop" />
        <!-- An app on Shizuku's API asks for the shell (shell/ShellApps.kt). -->
        <activity
            android:name=".shell.PermissionActivity"
            android:exported="false"
            android:label="Shell access"
            android:launchMode="singleTop"
            android:excludeFromRecents="true" />
        <receiver android:name=".shell.ShellApps$DenyReceiver" android:exported="false" />
        <!-- The pairing code typed into the notification, and Cancel (shell/Pairing.kt). -->
        <receiver android:name=".shell.Pairing$Receiver" android:exported="false" />

        <!-- The hotspot's mode (Hotspot.kt), and the Mac's requests from the
             Bluetooth LE scan's PendingIntent. -->
        <service
            android:name=".HotspotTileService"
            android:exported="true"
            android:label="Hotspot"
            android:icon="@drawable/ic_hotspot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name=".Hotspot$ScanReceiver" android:exported="false" />
        <!-- The hotspot page (HotspotActivity): from the Phone tab, and the
             tile's long press (QS_TILE_PREFERENCES, which System UI starts). -->
        <activity
            android:name=".HotspotActivity"
            android:exported="true"
            android:label="Hotspot"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
