# rocky-prism-ffi (this directory): rocky-prism for the apps, built by Nix
# from the workspace's Cargo.lock, offline.
#
# - `host`: the library for this machine (lib/librocky_prism_ffi.{dylib,so,a})
#   and gobley's bindgen (bin/uniffi-bindgen, ../uniffi-bindgen). The JVM
#   check loads the cdylib; on an Apple Silicon Mac the staticlib is the
#   one PrismShared.framework links.
# - `bindings`: the Kotlin Multiplatform sources and C header the bindgen
#   reads out of the library (commonMain, jvmMain, nativeMain,
#   nativeInterop/cinterop/headers); shared/default.nix puts them into
#   shared/'s source sets.
# - `android`: the cdylib for Android (lib/<abi>/librocky_prism_ffi.so, for
#   arm64-v8a, armeabi-v7a for 32-bit TVs and, for the emulator, x86_64;
#   `androidAbi` builds one),
#   cross-compiled with the NDK's clang by Rust's prebuilt toolchain
#   (`rustToolchain`).
#
# Rocky's SQLite is the bundled one (LIBSQLITE3_SYS_USE_PKG_CONFIG=0, as
# for prism-worker), its bindings generated by bindgen; rustls uses ring,
# which the NDK's clang compiles.
{ pkgs }:
let
  lib = pkgs.lib;
  rust = pkgs.rustPlatform;

  src = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.unions [
      ../Cargo.toml
      ../Cargo.lock
      ../cli
      ../rocky-prism
      ../rocky-prism-ffi
      ../uniffi-bindgen
      ../worker
    ];
  };
  cargoDeps = rust.importCargoLock {
    lockFile = ../Cargo.lock;
    # Rocky's checkout, as in flake.nix (no git needed to evaluate).
    outputHashes."rocky-core-0.1.0" = "sha256-EPqlnNFL0UHDmnwii+zNLQolzbIcSOx4PWyaXf6+G2E=";
  };

  version = "0.1.0";
  dylib = pkgs.stdenv.hostPlatform.extensions.sharedLibrary;

  host = pkgs.stdenv.mkDerivation {
    pname = "rocky-prism-ffi";
    inherit version src cargoDeps;
    nativeBuildInputs = [
      rust.cargoSetupHook
      pkgs.cargo
      pkgs.rustc
      rust.bindgenHook
    ];
    buildPhase = ''
      runHook preBuild
      export LIBSQLITE3_SYS_USE_PKG_CONFIG=0
      cargo build --release --offline -p rocky-prism-ffi -p prism-uniffi-bindgen
      runHook postBuild
    '';
    installPhase = ''
      runHook preInstall
      install -Dm755 target/release/librocky_prism_ffi${dylib} $out/lib/librocky_prism_ffi${dylib}
      install -Dm644 target/release/librocky_prism_ffi.a $out/lib/librocky_prism_ffi.a
      install -Dm755 target/release/uniffi-bindgen $out/bin/uniffi-bindgen
      runHook postInstall
    '';
    # The archive keeps its symbols for the framework's link.
    dontStrip = true;
  };

  bindings = pkgs.runCommand "rocky-prism-ffi-bindings" { } ''
    ${host}/bin/uniffi-bindgen ${host}/lib/librocky_prism_ffi${dylib} $out ${./uniffi.toml}
  '';

  # --- Android ---

  # The NDK the app's other native code uses (android/shizuku, android/netbird).
  ndkVersion = "29.0.14206865";
  ndk = "${
    (pkgs.androidenv.composeAndroidPackages {
      platformVersions = [ ];
      buildToolsVersions = [ ];
      includeEmulator = false;
      includeSystemImages = false;
      includeNDK = true;
      ndkVersions = [ ndkVersion ];
    }).ndk-bundle
  }/libexec/android-sdk/ndk-bundle";
  ndkHost = if pkgs.stdenv.buildPlatform.isDarwin then "darwin-x86_64" else "linux-x86_64";
  minSdk = "31";

  abis = {
    arm64-v8a = "aarch64-linux-android";
    # 32-bit Android TVs.
    armeabi-v7a = "armv7-linux-androideabi";
    x86_64 = "x86_64-linux-android";
  };
  # The NDK names its clang for armv7 differently from Rust's target.
  clangTarget =
    target: if target == "armv7-linux-androideabi" then "armv7a-linux-androideabi" else target;

  # Rust for the cross build: Rust's own prebuilt toolchain (rustc, cargo and
  # the host's standard library, as rustup installs them) with the prebuilt
  # standard library of each Android target. nixpkgs' rustc is built from
  # source and refuses a standard library it didn't build ("compiled by an
  # incompatible version of rustc"), and nixpkgs has none for Android.
  # The hosts are those the NDK's clang runs on.
  rustVersion = "1.99.1";
  rustDist =
    {
      aarch64-darwin = {
        triple = "aarch64-apple-darwin";
        rustc = "sha256-I5SKCpwWL9KVLe+z+wRixE6Pz9Gkq4onSh4b2yz4EKM=";
        cargo = "sha256-aF5WPZTbHwA/+l9YMUOe7AJWm5lQtphnlTyCEyacHq8=";
        rust-std = "sha256-/nnWq1oDId4mRjmZ2MESuK0+r7y8+CLWaiMAtF3eEDE=";
      };
      x86_64-darwin = {
        triple = "x86_64-apple-darwin";
        rustc = "sha256-ID/u8sIWXX3aHzDM91WQ9ypqvFLOJZ7RxBjehKaIdpg=";
        cargo = "sha256-ZjbavOwWSQnRxuueLFlhSHh8hPfToC/2ihQVaQd/gLU=";
        rust-std = "sha256-SE1biLQk3dKd8Zbh65QgyDNbtfrJCjw3FAJTNFqMZcQ=";
      };
      x86_64-linux = {
        triple = "x86_64-unknown-linux-gnu";
        rustc = "sha256-L/Bf+cCKkIYef25AZbQKi4dGO0V2GG/WE4ccPjfyCR8=";
        cargo = "sha256-U/NSGUlATVle+walXBLFZY1O0cdVZvM9PVFOrr5wvYo=";
        rust-std = "sha256-EJsHQiW/W56jggiQh2v99O0WGtv6+UsrS1mEyF7l2Vg=";
      };
    }
    .${pkgs.stdenv.buildPlatform.system}
      or (throw "rocky-prism-ffi: no Android build on ${pkgs.stdenv.buildPlatform.system}");
  androidStd = {
    aarch64-linux-android = "sha256-dGOwa7X3NMAtO6yWdTi03k2pEPuQZoOYvCGxC1Yg410=";
    armv7-linux-androideabi = "sha256-jFyNK7H69VGrId48n5+TC/x+YQIi4Iv65DuUOEE/4wA=";
    x86_64-linux-android = "sha256-SBMs0fQKgRI0Xq1F6Eg0latIKF8VIQDzrhsRkL7U2NQ=";
  };
  dist =
    component: triple: hash:
    pkgs.fetchurl {
      url = "https://static.rust-lang.org/dist/${component}-${rustVersion}-${triple}.tar.xz";
      inherit hash;
    };
  rustToolchain = pkgs.stdenv.mkDerivation {
    pname = "rust-android-toolchain";
    version = rustVersion;
    srcs = [
      (dist "rustc" rustDist.triple rustDist.rustc)
      (dist "cargo" rustDist.triple rustDist.cargo)
      (dist "rust-std" rustDist.triple rustDist.rust-std)
    ]
    ++ lib.mapAttrsToList (target: hash: dist "rust-std" target hash) androidStd;
    sourceRoot = ".";
    nativeBuildInputs = lib.optionals pkgs.stdenv.buildPlatform.isLinux [ pkgs.autoPatchelfHook ];
    buildInputs = lib.optionals pkgs.stdenv.buildPlatform.isLinux [
      pkgs.zlib
      pkgs.stdenv.cc.cc.lib
    ];
    # Each archive is <name>/<component>/{bin,lib,...} plus an installer.
    installPhase = ''
      mkdir -p $out
      for component in */*/; do
        [ -f $component/manifest.in ] && cp -r $component/. $out/
      done
      rm -f $out/manifest.in
    '';
    dontStrip = true;
  };

  # The cdylib for one ABI: lib/<abi>/librocky_prism_ffi.so.
  androidAbi =
    abi:
    let
      target = abis.${abi};
      var = lib.replaceStrings [ "-" ] [ "_" ] target;
      env = lib.toUpper var;
      cc = "$toolchain/bin/${clangTarget target}${minSdk}-clang";
    in
    pkgs.stdenv.mkDerivation {
      pname = "rocky-prism-ffi-android-${abi}";
      inherit version src cargoDeps;
      nativeBuildInputs = [
        rust.cargoSetupHook
        rustToolchain
        rust.bindgenHook
      ];
      buildPhase = ''
        runHook preBuild
        export LIBSQLITE3_SYS_USE_PKG_CONFIG=0
        toolchain=${ndk}/toolchains/llvm/prebuilt/${ndkHost}
        # The NDK's clang compiles (SQLite, ring) and links, for 16 KB pages.
        export CC_${var}=${cc} AR_${var}=$toolchain/bin/llvm-ar CARGO_TARGET_${env}_LINKER=${cc}
        export CARGO_TARGET_${env}_RUSTFLAGS="-C link-arg=-Wl,-z,max-page-size=16384 -C link-arg=-Wl,-z,common-page-size=16384"
        export BINDGEN_EXTRA_CLANG_ARGS_${var}="--target=${clangTarget target}${minSdk} --sysroot=$toolchain/sysroot"
        # Small over fast: the library is stored uncompressed in the APK.
        export CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
        cargo rustc --release --offline -p rocky-prism-ffi --lib --crate-type cdylib --target ${target}
        so=$out/lib/${abi}/librocky_prism_ffi.so
        install -Dm755 target/${target}/release/librocky_prism_ffi.so $so
        $toolchain/bin/llvm-strip --strip-unneeded $so
        if $toolchain/bin/llvm-readelf -lW $so | awk '$1 == "LOAD" && $NF != "0x4000" { bad = 1 } END { exit !bad }'; then
          $toolchain/bin/llvm-readelf -lW $so
          echo "${abi}: a LOAD segment is not 16 KB aligned" >&2
          exit 1
        fi
        runHook postBuild
      '';
      dontInstall = true;
      # An Android ELF: no patchelf, no host strip.
      dontFixup = true;
    };

  # Every ABI; the APK takes arm64-v8a and armeabi-v7a (androidAbi), as its
  # other native libraries.
  android = pkgs.symlinkJoin {
    name = "rocky-prism-ffi-android";
    paths = map androidAbi (lib.attrNames abis);
  };
in
{
  inherit
    src
    cargoDeps
    host
    bindings
    androidAbi
    android
    ;
}
